local function setResetButton(enabled)

	task.spawn(function()
		for i = 1,25 do
			local success = pcall(function()
				StarterGui:SetCore("ResetButtonCallback",enabled)
			end)
			if success then
				return
			end
			task.wait(0.15)
		end
	end)

end

local function clearConnections()

	for _,connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)

end

local function enableAntiDie()

	AntiDie = true
	antiButton.Text = "ANTI DIE   •   ON"
	antiButton.BackgroundColor3 = Color3.fromRGB(20,115,65)
	antiButton.TextColor3 = Color3.fromRGB(225,255,235)
	status.Text = "Protection enabled"
	status.TextColor3 = Color3.fromRGB(80,255,145)
	setResetButton(false)
	clearConnections()
	local character = LP.Character
	if character then
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.BreakJointsOnDeath = false
			humanoid.MaxHealth = 1000000000
			humanoid.Health = humanoid.MaxHealth
			pcall(function()
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead,false)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown,false)
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll,false)
			end)
			table.insert(connections,
				humanoid.HealthChanged:Connect(function(health)
					if AntiDie and health < humanoid.MaxHealth then
						humanoid.Health = humanoid.MaxHealth
					end
				end)
			)
		end
	end

end

