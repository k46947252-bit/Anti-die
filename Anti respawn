local function checkKey()

	-- Нажатие кнопки обязательно
	local enteredKey = keyBox.Text
	if enteredKey == CORRECT_KEY then
		KeyAccepted = true
		keyStatus.Text = "✓ KEY ACCEPTED"
		keyStatus.TextColor3 = Color3.fromRGB(70,255,130)
		checkButton.Text = "✓ ДОСТУП РАЗРЕШЁН"
		checkButton.BackgroundColor3 = Color3.fromRGB(25,150,80)
		-- СНАЧАЛА принимаем ключ
		task.wait(0.7)
		-- Потом закрываем Key System
		keyFrame.Visible = false
		-- Открываем главное меню
		main.Visible = true
		-- И СРАЗУ создаём постоянную надпись
		if LP.Character then
			createHeadTag(LP.Character)
		end
	else
		keyStatus.Text = "✕ НЕВЕРНЫЙ КЛЮЧ"
		keyStatus.TextColor3 = Color3.fromRGB(255,70,80)
		checkButton.Text = "НЕВЕРНЫЙ КЛЮЧ"
		checkButton.BackgroundColor3 = Color3.fromRGB(170,45,55)
		task.delay(0.7,function()
			if checkButton then
				checkButton.Text = "ПРОВЕРИТЬ КЛЮЧ"
				checkButton.BackgroundColor3 = Color3.fromRGB(55,105,255)
			end
		end)
	end

end

-- Только кнопка ПРОВЕРИТЬ КЛЮЧ принимает ключ

