--==================================================

local tagColors = {

	Color3.fromRGB(0,140,255),
	Color3.fromRGB(255,255,255),
	Color3.fromRGB(0,255,100),
	Color3.fromRGB(255,225,0),
	Color3.fromRGB(0,220,255),
	Color3.fromRGB(0,140,255)

}

local function createHeadTag(character)

	if billboard then
		billboard:Destroy()
		billboard = nil
	end
	if gradientConnection then
		gradientConnection:Disconnect()
		gradientConnection = nil
	end
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end
	billboard = Instance.new("BillboardGui")
	billboard.Name = "MiguelPermanentTag"
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(310,75)
	billboard.StudsOffset = Vector3.new(0,3.2,0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 1000
	billboard.Parent = head
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1,1)
	text.BackgroundTransparency = 1
	text.Text = "#1 BEST PAID ANTI DIE\n" ..
		"discord.gg/etfy9Ctun"
	text.TextSize = 15
	text.Font = Enum.Font.GothamBold
	text.TextStrokeTransparency = 0.2
	text.TextStrokeColor3 = Color3.new(0,0,0)
	text.Parent = billboard
	local gradient = Instance.new("UIGradient")
	gradient.Parent = text
	local current = 1
	local progress = 0
	gradientConnection = RunService.RenderStepped:Connect(function(dt)
		if not billboard or not billboard.Parent then
			return
		end
		progress += dt * 0.8
		if progress >= 1 then
			progress = 0
			current += 1
			if current >= #tagColors then
				current = 1
			end
		end
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0,tagColors[current]),
			ColorSequenceKeypoint.new(0.5,tagColors[current + 1]),
			ColorSequenceKeypoint.new(1,tagColors[current])
		})
	end)

end

